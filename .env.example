DB_PASSWORD=change-me
# Name of the server in the HTTPS certificate (deploy/certs/server.crt), e.g. acces.bhh.local
BHH_SERVER_NAME=acces.bhh.local
# Daily backup (service "backup"): time (site time), days kept, host folder to copy off the VM
# BACKUP_TIME=02:00
# BACKUP_KEEP_DAYS=14
# BACKUP_DIR=./backups
BHH_JWT_SECRET=generate-a-long-random-string-of-32+chars
BHH_INITIAL_ADMIN_USERNAME=admin
BHH_INITIAL_ADMIN_PASSWORD=change-me-now
# openssl genpkey -algorithm ed25519  -> paste PEM on one line with \n
BHH_QR_PRIVATE_KEY_PEM=
# Key change: put the former key here (private or public PEM, several blocks allowed), the new
# one above. Badges printed with the former key keep working until reprinted; follow the count
# in Paramétrage > Configuration (« Clés de signature des QR »), then empty this line.
# BHH_QR_PREVIOUS_KEYS_PEM=
# Back-office sessions (also adjustable in Paramétrage > Configuration):
# BHH_ACCESS_TOKEN_MINUTES=15
# BHH_REFRESH_TOKEN_HOURS=8
